{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "subprocess test main",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/blendforces.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true
        },
        {
            "name": "attach visualize subprocess",
            "type": "python",
            "request": "attach",
            "processId": "${}",
        }
    ]
}